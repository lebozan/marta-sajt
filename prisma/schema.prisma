generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Float
  image       String
  images      String[]
  colors      String[]
  sizes       String[]
  type        String   @default("dress")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  sessionId String
  productId String
  name      String
  price     Float
  image     String
  color     String
  size      String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([sessionId, productId, color, size])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  sessionId String
  productId String
  name      String
  price     Float
  image     String
  color     String
  size      String
  createdAt DateTime @default(now())

  @@unique([sessionId, productId, color, size])
}

model CarouselSlide {
  id       Int     @id @default(autoincrement())
  image    String
  eyebrow  String  @default("")
  heading  String  @default("")
  ctaLabel String  @default("Shop Now")
  ctaLink  String  @default("dresses.html")
  position Int     @default(0)
  active   Boolean @default(true)
}

model WishlistInquiry {
  id        Int      @id @default(autoincrement())
  sessionId String
  contact   String
  message   String   @default("")
  items     Json
  createdAt DateTime @default(now())
}

model Order {
  id        String      @id @default(cuid())
  sessionId String
  paypalId  String      @unique
  status    String
  total     Float
  items     OrderItem[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id       Int    @id @default(autoincrement())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id])
  name     String
  price    Float
  quantity Int
  color    String
  size     String
}
